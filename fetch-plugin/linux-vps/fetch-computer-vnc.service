[Unit]
Description=Fetch virtual computer (TigerVNC + XFCE)
After=network.target

[Service]
Type=simple
Environment=DISPLAY=:1
Environment=XAUTHORITY=%h/.local/share/fetch-computer/Xauthority
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS SESSION_MANAGER WAYLAND_DISPLAY XDG_SESSION_TYPE
ExecStart=%h/.local/share/fetch-computer/run-virtual-desktop.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
